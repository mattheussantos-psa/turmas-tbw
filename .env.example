# ---- HubSpot ----
# Private App em Settings > Integrations > Private Apps.
# Scopes de LEITURA necessários:
#   crm.objects.deals.read      -> os negócios ganhos do Funil de Vendas B2C
#   crm.objects.contacts.read   -> o nome do contato associado a cada negócio
# Sem o contacts.read o painel carrega, mas o nome do aluno cai no nome do negócio.
# NUNCA use o prefixo NEXT_PUBLIC_ aqui: isso mandaria o token para o navegador.
HUBSPOT_TOKEN=pat-na1-xxxxxxxx

# Os três abaixo têm padrão no código e só precisam ser setados se mudarem no HubSpot.
# Funil de Vendas B2C:
HUBSPOT_PIPELINE_B2C=725182862
# Estágio "Ganho" DESSE funil (o 1076664460 "Ganho / Contrato assinado" é do B2B, não serve):
HUBSPOT_STAGE_GANHO=1105295876
HUBSPOT_PORTAL_ID=49656171
